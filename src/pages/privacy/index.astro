---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import business from '../../data/business.json';
import copy from '../../data/copy.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../../lib/seo';

const { privacy } = copy;
const path = '/privacy/';
const breadcrumbs = [
  { name: copy.site.breadcrumbHome, path: '/' },
  { name: privacy.breadcrumb, path },
];
---

<BaseLayout
  title={privacy.metaTitle}
  description={privacy.metaDescription}
  {path}
  schema={[breadcrumbSchema(business.siteUrl.value, breadcrumbs)]}
>
  <div class="wrap page-head">
    <Breadcrumbs items={breadcrumbs} />
    <h1>{privacy.h1}</h1>
    <p class="page-head__lead">{privacy.lead}</p>
  </div>

  <div class="wrap privacy">
    {
      privacy.sections.map(({ heading, paragraphs, list, deletionEmail }) => (
        <section class="text-row">
          <h2>{heading}</h2>
          <div class="text-row__body">
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {list && (
              <ul class="privacy__list">
                {list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {deletionEmail && (
              <p class="privacy__email">
                <span>{privacy.deletionEmailLabel}</span>
                <a href={`mailto:${business.email.value}`}>{business.email.value}</a>
              </p>
            )}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .privacy {
    padding-block-end: var(--space-2xl);
  }

  .privacy h2 {
    font-size: var(--text-xl);
  }

  .privacy__list {
    display: grid;
    gap: var(--space-2xs);
    padding-inline-start: var(--space-lg);
    list-style: square;
  }

  .privacy__list li::marker {
    color: var(--color-accent);
  }

  .privacy__email {
    display: grid;
    margin-block-start: var(--space-xs);
    font-weight: var(--weight-strong);
  }

  .privacy__email span {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-body);
  }

  .privacy__email a {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: var(--tap-target);
    overflow-wrap: anywhere;
  }
</style>
