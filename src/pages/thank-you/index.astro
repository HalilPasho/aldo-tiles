---
import { Image } from 'astro:assets';
import Button from '../../components/Button.astro';
import CallLink from '../../components/CallLink.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import shower from '../../assets/sample-thank-you-shower.png';
import copy from '../../data/copy.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
const { thankYou } = copy;
---
<BaseLayout title={thankYou.metaTitle} description={thankYou.metaDescription} path="/thank-you/" noindex>
  <div class="wrap sent-wrap">
    <section class="sent-card">
      <div class="sent-main">
        <div class="sent-copy">
          <div class="sent-heading">
            <svg class="sent-check" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="20"/><path d="m14 24 7 7 14-15"/></svg>
            <h1>{thankYou.titleLines.map(line => <span>{line}</span>)}</h1>
          </div>
          <p class="sent-text">{thankYou.text}</p>
          <div class="sent-links">
            <Button href="/"><ServiceIcon name="home"/>{thankYou.homeLabel}</Button>
            <Button href="/projects/" variant="secondary"><ServiceIcon name="layers"/>{thankYou.projectsLabel}</Button>
          </div>
        </div>
        <div class="sent-photo"><Image src={shower} alt={thankYou.imageAlt} widths={[480,800,1200,1600]} sizes="(min-width: 900px) max(45vw,800px), max(100vw,480px)" loading="eager" fetchpriority="high" /></div>
      </div>
      <div class="sent-call on-ink">
        <svg class="sent-call__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
        <p>{thankYou.callPrompt}</p>
        <CallLink variant="button"/>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  .sent-wrap { padding-block: var(--sent-outer-space); }
  .sent-card { overflow: clip; border: var(--line-thin) solid var(--color-line); border-radius: var(--sent-radius); background: var(--color-surface-raised); box-shadow: var(--shadow-trust-card); }
  .sent-main { display: grid; }
  .sent-copy { display: grid; gap: var(--space-lg); padding: var(--sent-padding); align-content: center; }
  .sent-heading { display: grid; grid-template-columns: var(--sent-check-size) minmax(0,1fr); gap: var(--space-md); align-items: center; }
  h1 { font-size: var(--type-title); line-height: var(--leading-tight); padding-inline-start: var(--space-md); border-inline-start: var(--line-strong) solid var(--color-accent); text-wrap: initial; }
  h1 > span { display: block; }
  h1::after { content: ''; display: block; width: var(--space-xl); height: var(--service-design-rule); margin-block-start: var(--space-sm); border-radius: var(--radius-tile); background: var(--color-accent); }
  .sent-check { width: var(--sent-check-size); height: var(--sent-check-size); fill: none; stroke: var(--color-accent); stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }
  .sent-text { font-size: var(--text-lg); line-height: var(--leading-lead); color: var(--color-ink); }
  .sent-links { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .sent-links :global(.button) { font-size: var(--home-button-size); }
  .sent-links :global(svg) { width: var(--sent-button-icon); height: var(--sent-button-icon); flex: none; }
  .sent-photo { position: relative; min-height: var(--sent-phone-photo-height); background: var(--color-accent); }
  .sent-photo :global(img) { width: 100%; height: 100%; position: absolute; inset: 0; object-fit: cover; object-position: center; }
  .sent-call { position: relative; display: grid; grid-template-columns: var(--sent-call-icon) minmax(0,1fr); align-items: center; gap: var(--space-md); padding: var(--sent-padding); padding-inline-end: var(--sent-corner-clearance); border-start-start-radius: var(--sent-call-radius); background: var(--color-ink); }
  .sent-call__icon { width: var(--sent-call-icon); height: var(--sent-call-icon); fill: none; stroke: var(--color-on-ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .sent-call p { border-inline-start: var(--line-strong) solid var(--color-accent-on-ink); padding-inline-start: var(--space-md); font-size: var(--text-lg); font-weight: var(--weight-strong); line-height: var(--leading-lead); }
  .sent-call :global(.button) { grid-column: 1 / -1; justify-self: start; font-size: var(--text-base); background: linear-gradient(115deg,var(--color-gold-button-start),var(--color-gold-button-end)); }
  .sent-call::before,.sent-call::after { content: ''; position: absolute; bottom: 0; right: 0; width: var(--sent-corner); height: var(--sent-corner); clip-path: polygon(100% 0,100% 100%,0 100%); pointer-events: none; }
  .sent-call::before { background: var(--color-accent-on-ink); }
  .sent-call::after { width: calc(var(--sent-corner) - var(--space-xs)); height: calc(var(--sent-corner) - var(--space-xs)); background: var(--color-surface-raised) url('../../assets/sample-marble-tile-stack.png') right top / 300%; }
  @media(max-width: 899px) {
    .sent-call { display: flex; flex-wrap: wrap; padding-inline-end: var(--sent-padding); padding-block-end: var(--sent-mobile-clearance); }
    .sent-call__icon { flex: none; }
    .sent-call p { flex: 1 1 var(--sent-call-copy-basis); min-width: 0; }
  }
  @media(max-width: 639px) {
    .sent-links :global(.button) { width: 100%; }
    .sent-heading { grid-template-columns: minmax(0,1fr); }
    h1 { padding-inline-start: 0; border-inline-start: 0; }
  }
  @media(min-width: 900px) {
    .sent-main { grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); }
    .sent-photo { clip-path: polygon(24% 0,100% 0,100% 100%,0 100%); min-height: var(--sent-photo-height); }
    .sent-photo :global(img) { clip-path: polygon(27% 0,100% 0,100% 100%,3% 100%); }
    .sent-call { grid-template-columns: var(--sent-call-icon) minmax(0,1fr) auto; }
    .sent-call :global(.button) { grid-column: auto; }
  }
</style>
