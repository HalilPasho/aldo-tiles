---
import { getCollection, type CollectionEntry } from 'astro:content';
import ServicePage from '../../../components/ServicePage.astro';
export async function getStaticPaths() {
  return (await getCollection('services')).map(service => ({params:{slug:service.id},props:{service}}));
}
interface Props {service: CollectionEntry<'services'>;}
const {service} = Astro.props;
---
<ServicePage {service} />
<style>
@container page (min-width: 77.5rem) {
  :global(.service-detail) { gap: var(--space-2xl); }
}
</style>
