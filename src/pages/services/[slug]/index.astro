---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Button from '../../../components/Button.astro';
import CallLink from '../../../components/CallLink.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Faq from '../../../components/Faq.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import business from '../../../data/business.json';
import copy from '../../../data/copy.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { byOrder } from '../../../lib/order';
import { breadcrumbSchema, localBusinessSchema, serviceSchema } from '../../../lib/seo';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { title, metaTitle, metaDescription, h1, summary, highlights, faqs } = service.data;
const { servicePage } = copy;
const { Content } = await render(service);

const path = `/services/${service.id}/`;
const breadcrumbs = [
  { name: copy.site.breadcrumbHome, path: '/' },
  { name: title, path },
];

const related = (await getCollection('projects', ({ data }) => data.service.id === service.id)).sort(byOrder);
// Each project card shows its first photo, so the page's lead photo comes from the ones left over.
const leadPhoto = related.flatMap(({ data }) => data.photos.slice(1))[0];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  {path}
  schema={[
    localBusinessSchema(business),
    serviceSchema(business, { name: title, description: summary, path }),
    breadcrumbSchema(business.siteUrl.value, breadcrumbs),
  ]}
>
  <div class:list={['wrap service-head', { 'service-head--photo': leadPhoto }]}>
    <div class="page-head service-head__copy">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{h1}</h1>
      <p class="page-head__lead">{summary}</p>
      <div class="service-head__actions">
        <CallLink variant="button" />
        <Button href={copy.site.cta.messagePath} variant="secondary">{copy.site.cta.messageLabel}</Button>
      </div>
    </div>
    {
      leadPhoto && (
        <div class="service-head__frame">
          <Image
            class="service-head__photo"
            src={leadPhoto.src}
            alt={leadPhoto.alt}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1280px) 540px, (min-width: 900px) 42vw, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </div>

  <div class="wrap service-detail">
    <div class="service-prose">
      <Content />
    </div>
    {
      highlights.length > 0 && (
        <aside class="panel on-ink service-highlights">
          <h2 class="service-highlights__heading">{servicePage.highlightsHeading}</h2>
          <ul class="service-highlights__list">
            {highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>

  <div class="wrap service-rows">
    {
      related.length > 0 && (
        <section class="text-row">
          <h2>{servicePage.projectsHeading}</h2>
          <ul class="service-projects">
            {related.map((project) => (
              <li>
                <ProjectCard
                  {project}
                  sizes="(min-width: 1280px) 390px, (min-width: 760px) 30vw, (min-width: 560px) 50vw, 100vw"
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <Faq heading={servicePage.faqHeading} items={faqs} />
  </div>

  <CtaBand heading={servicePage.ctaHeading} text={servicePage.ctaText} />
</BaseLayout>

<style>
  .service-head {
    display: grid;
    gap: var(--space-md) var(--space-xl);
    padding-block-end: var(--space-xl);
  }

  .service-head__copy {
    padding-block-end: 0;
    align-content: start;
    min-width: 0;
  }

  .service-head__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-start: var(--space-xs);
  }

  /* The photo fills a frame of fixed shape, so a tall phone shot can't change the height of the page head. */
  .service-head__frame {
    position: relative;
    align-self: start;
    aspect-ratio: var(--service-photo-ratio);
  }

  .service-head__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-tile);
  }

  .service-detail {
    display: grid;
    gap: var(--space-xl) var(--space-2xl);
    padding-block-end: var(--space-2xl);
  }

  .service-prose {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
  }

  .service-prose :global(h2) {
    margin-block-start: var(--space-lg);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .service-prose :global(h2:first-child) {
    margin-block-start: 0;
  }

  .service-highlights {
    display: grid;
    align-content: start;
    gap: var(--space-md);
  }

  .service-highlights__heading {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .service-highlights__list {
    display: grid;
    gap: var(--space-sm);
  }

  .service-highlights__list li {
    position: relative;
    padding-inline-start: var(--space-lg);
  }

  /* A tiny raked tile from the logo stands in for the list bullet. */
  .service-highlights__list li::before {
    content: '';
    position: absolute;
    inset-block-start: var(--bullet-offset);
    inset-inline-start: var(--space-2xs);
    width: var(--bullet-size);
    height: var(--bullet-size);
    border-radius: var(--line-thin);
    background: var(--color-accent);
    transform: skewX(var(--rake));
  }

  .service-rows {
    padding-block-end: var(--space-xl);
  }

  .service-projects {
    display: grid;
    gap: var(--space-xl) var(--grout);
    min-width: 0;
  }

  @media (min-width: 560px) {
    .service-projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .service-head--photo {
      grid-template-columns: var(--service-head-columns);
    }

    .service-head__frame {
      margin-block-start: var(--space-sm);
    }

    .service-detail:has(> .service-highlights) {
      grid-template-columns: var(--panel-split-columns);
      align-items: start;
    }

    .service-highlights {
      position: sticky;
      inset-block-start: var(--space-md);
    }
  }

  @container page (min-width: 77.5rem) {
    .service-highlights {
      inset-block-start: calc(var(--header-sticky-height) + var(--space-md));
    }
  }
</style>
