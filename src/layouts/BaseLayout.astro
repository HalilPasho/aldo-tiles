---
import type { ImageMetadata } from 'astro';
import defaultShareImage from '../assets/sample-hero.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import Seo from '../components/seo/Seo.astro';
import copy from '../data/copy.json';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object[];
  noindex?: boolean;
  ogImage?: ImageMetadata;
}

const { title, description, path, schema, noindex, ogImage = defaultShareImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Seo {title} {description} {path} {schema} {noindex} {ogImage} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.site.skipLink}</a>
    <PreviewBanner />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
