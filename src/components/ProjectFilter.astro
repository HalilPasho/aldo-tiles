---
import copy from '../data/copy.json';

interface Props {
  options: { id: string; label: string }[];
  allLabel?: string;
  showIcons?: boolean;
}

const { options, allLabel, showIcons = false } = Astro.props;
const { filterLegend, filterAll } = copy.projects;

const iconPaths: Record<string,string> = {
  all: 'M4 4h14v14H4Zm26 0h14v14H30ZM4 30h14v14H4Zm26 0h14v14H30Z',
  'bathroom-shower-tile-installation': 'M12 44V14a9 9 0 0 1 18 0v5M23 20h14l-2-5H25Zm2 6v3m9-3v3m-4 5v3m-10-3v3m19-3v3M7 44h10',
  'floor-tile-installation': 'm4 12 20-9 20 9-20 9Zm2 11-2 2 20 9 20-9-2-2M6 35l-2 2 20 9 20-9-2-2',
  'kitchen-backsplash-installation': 'M3 7h42M3 18h42M3 29h42M3 40h42M12 7v11m24-11v11M23 18v11M12 29v11m24-11v11M3 7v33m42-33v33',
  'commercial-tile-installation': 'M13 44V5h22v39M5 44V20h8m22 0h8v24M2 44h44M20 12h2m5 0h2m-9 8h2m5 0h2m-9 8h2m5 0h2m-9 16V35h9v9',
};
const choices = [{ id: 'all', label: allLabel ?? filterAll }, ...options];
---

<fieldset class="project-filter" data-project-filter>
  <legend class="project-filter__legend">{filterLegend}</legend>
  <div class="project-filter__options">
    {
      choices.map(({ id, label }, index) => (
        <label class="project-filter__option">
          <input class="project-filter__radio" type="radio" name="project-filter" value={id} checked={index === 0} />
          <span class="project-filter__tile">{showIcons && <svg class="project-filter__icon" viewBox="0 0 48 48" aria-hidden="true"><path d={iconPaths[id] ?? iconPaths.all} /></svg>}<span>{label}</span></span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .project-filter__icon { flex: none; width: var(--portfolio-filter-icon); height: var(--portfolio-filter-icon); fill: none; stroke: currentColor; stroke-width: 2.7; stroke-linecap: round; stroke-linejoin: round; }
  /* A fieldset refuses to shrink below its content unless told to, which would push a phone's page sideways. */
  .project-filter {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .project-filter__legend {
    padding: 0;
    margin-block-end: var(--space-xs);
    font-weight: var(--weight-strong);
  }

  .project-filter__options {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grout);
  }

  .project-filter__option {
    position: relative;
    display: flex;
    flex: 1 1 auto;
  }

  /* The real radio covers its whole tile, so the tap target and keyboard behaviour are the browser's own. */
  .project-filter__radio {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .project-filter__tile {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-sm);
    min-height: var(--tap-target);
    padding: var(--space-xs) var(--space-md);
    border: var(--line-thin) solid var(--color-line);
    border-radius: var(--radius-tile);
    background: var(--color-surface-raised);
    line-height: var(--leading-tight);
    transition:
      background-color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out);
  }

  /* The logo's raked tile stands in for the radio's dot. It stays empty until chosen, so colour isn't the only signal. */
  .project-filter__tile::before {
    content: '';
    flex: none;
    width: var(--bullet-size);
    height: var(--bullet-size);
    border: var(--line-thin) solid var(--color-field-line);
    border-radius: var(--line-thin);
    transform: skewX(var(--rake));
  }

  .project-filter__radio:hover + .project-filter__tile {
    border-color: var(--color-ink);
  }

  .project-filter__radio:checked + .project-filter__tile {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-on-ink);
  }

  .project-filter__radio:checked + .project-filter__tile::before {
    border-color: var(--color-accent-on-ink);
    background: var(--color-accent-on-ink);
  }

  .project-filter__radio:focus-visible + .project-filter__tile {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--line-strong);
  }

  @media (forced-colors: active) {
    .project-filter__radio:checked + .project-filter__tile::before {
      forced-color-adjust: none;
    }
  }
</style>
