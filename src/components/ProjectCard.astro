---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';

interface Props {
  project: CollectionEntry<'projects'>;
  sizes?: string;
  eager?: boolean;
  previewPhoto?: ImageMetadata;
  previewAlt?: string;
  categoryLabel?: string;
  badgeLabel?: string;
}

const { project, sizes = '(min-width: 1100px) 400px, (min-width: 640px) 50vw, 100vw', eager = false, previewPhoto, previewAlt, categoryLabel, badgeLabel } = Astro.props;
const { title, city, tileType, photos } = project.data;
const [photo] = photos;
---

<article class="project-card">
  <div class="project-card__media"><Image
    class="project-card__photo"
    src={previewPhoto ?? photo.src}
    alt={previewAlt ?? photo.alt}
    widths={[400, 600, 800]}
    {sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
  {badgeLabel && <span class="project-card__badge"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="1"/><path d="m4 18 6-7 4 4 3-3 4 5"/><circle cx="16" cy="8" r="1"/></svg>{badgeLabel}</span>}
  </div><div class="project-card__text">
    <h3 class="project-card__title">
      <a class="project-card__link" href={`/projects/${project.id}/`}>{title}</a>
    </h3>
    <p class="project-card__city">{categoryLabel ?? city}</p>
    <p class="project-card__tile">{tileType}</p>
  </div>
</article>

<style>
  .project-card__media { position: relative; min-width: 0; }
  .project-card__badge { position: absolute; inset-inline-start: var(--space-sm); inset-block-end: var(--space-sm); display: inline-flex; align-items: center; gap: var(--space-xs); padding: var(--space-2xs) var(--space-sm); border-radius: var(--portfolio-badge-radius); background: var(--color-ink); color: var(--color-on-ink); font-size: var(--text-sm); line-height: var(--leading-tight); }
  .project-card__badge svg { flex: none; width: var(--portfolio-badge-icon); height: var(--portfolio-badge-icon); fill: none; stroke: currentColor; stroke-width: 1.7; }
  .project-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-sm);
    height: 100%;
  }

  .project-card__photo {
    width: 100%;
    height: auto;
    aspect-ratio: var(--project-photo-ratio);
    object-fit: cover;
    border-radius: var(--radius-tile);
  }

  .project-card__text {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
  }

  .project-card__title {
    font-size: var(--type-card-title);
    line-height: var(--leading-tight);
  }

  .project-card__link {
    text-decoration: none;
  }

  /* The whole card is the tap target, while screen readers hear only the project's name as the link. */
  .project-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-tile);
  }

  .project-card:hover .project-card__link {
    text-decoration: underline;
    text-decoration-thickness: var(--line-strong);
  }

  .project-card__link:focus-visible {
    outline: none;
  }

  .project-card__link:focus-visible::after {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: var(--line-strong);
  }

  .project-card__city {
    font-weight: var(--weight-strong);
  }

  .project-card__tile {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-lead);
  }
</style>
