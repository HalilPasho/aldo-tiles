---
import business from '../data/business.json';
import copy from '../data/copy.json';
import Button from './Button.astro';

interface Props {
  variant?: 'plain' | 'button';
}

const ICON_PATH =
  'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z';

const { variant = 'plain' } = Astro.props;
const href = `tel:${business.phone.e164}`;
const label = `${copy.site.callPrefix} ${business.name}: ${business.phone.display}`;
---

{
  variant === 'button' ? (
    <Button href={href} aria-label={label}>
      <svg class="call-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d={ICON_PATH} />
      </svg>
      <span class="call-number">{business.phone.display}</span>
    </Button>
  ) : (
    <a class="call-plain" href={href} aria-label={label}>
      <svg class="call-icon call-icon--accent" viewBox="0 0 24 24" aria-hidden="true">
        <path d={ICON_PATH} />
      </svg>
      <span class="call-number">{business.phone.display}</span>
    </a>
  )
}

<style>
  .call-plain {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    color: inherit;
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .call-plain:hover .call-number {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--line-strong);
    text-underline-offset: var(--underline-offset);
  }

  .call-icon {
    flex: none;
    width: var(--icon-size);
    height: var(--icon-size);
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .call-icon--accent {
    stroke: var(--color-accent);
  }

  /* Stays on one line unless large text leaves no room. It then breaks only at its space or hyphen, never between digits, and balance puts the break after the area code. */
  .call-number {
    overflow-wrap: normal;
    text-wrap: balance;
    font-variant-numeric: tabular-nums;
  }
</style>
