---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/sample-reference-hero.jpg';
import copy from '../data/copy.json';
import business from '../data/business.json';
import Button from './Button.astro';
const { hero } = copy.home;
---
<section class="hero" data-hero>
  <div class="hero__copy">
    <p class="hero__eyebrow">{business.name} / {business.baseCity}, {business.province}</p>
    <h1>{hero.titleLines[0]}<br />{hero.titleLines[1]}<em>{hero.highlight}</em></h1>
    <p class="hero__lead" data-hero-lead>{hero.lead}</p>
    <div class="hero__actions">
      <Button href="/contact/">{hero.formLabel}</Button>
      <Button href="/projects/" variant="secondary">{hero.workLabel}</Button>
    </div>
  </div>
  <div class="hero__media">
    <Image src={heroPhoto} alt={hero.imageAlt} widths={[480, 800, 1006]} sizes="(min-width: 761px) max(67vw, 1006px), 171vw" loading="eager" fetchpriority="high" />
  </div>
</section>
<style>
  .hero { position: relative; overflow: clip; background: var(--color-home-hero); }
  .hero__copy { position: relative; z-index: 1; padding: var(--home-hero-padding); }
  .hero__eyebrow { display: flex; align-items: center; gap: var(--space-sm); font-size: var(--home-eyebrow-size); font-weight: var(--weight-strong); letter-spacing: var(--home-eyebrow-tracking); text-transform: uppercase; }
  .hero__eyebrow::before { content: ''; flex: none; width: var(--home-eyebrow-line); height: var(--line-strong); background: var(--color-accent); }
  .hero h1 { font-family: var(--font-reference-display); font-weight: var(--weight-body); font-size: var(--home-hero-heading); letter-spacing: var(--home-heading-tracking); line-height: 1.04; margin-block: var(--space-lg) var(--space-md); text-wrap: initial; }
  .hero h1 em { color: var(--color-accent-text); font-style: normal; }
  .hero__lead { max-width: var(--home-hero-lead-width); font-size: var(--text-base); line-height: var(--leading-lead); }
  .hero h1, .hero__lead, .hero__actions { background: var(--color-home-hero); width: fit-content; }
  .hero h1, .hero__actions { max-width: 100%; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-block-start: var(--space-lg); }
  .hero__actions :global(.button) { font-size: var(--home-button-size); }
  .hero__media { position: relative; aspect-ratio: var(--hero-photo-ratio); }
  .hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 761px) {
    .hero { min-height: var(--home-hero-min-height); }
    .hero__copy { width: var(--home-hero-copy-width); padding: var(--home-hero-desktop-padding); }
    .hero__media { position: absolute; inset: 0 0 0 var(--home-hero-media-start); height: 100%; aspect-ratio: auto; background: var(--color-accent); clip-path: polygon(20% 0,100% 0,100% 100%,0 100%); }
    .hero__media img { clip-path: polygon(21% 0,100% 0,100% 100%,1% 100%); }
  }
  @media (min-width: 761px) and (max-width: 1100px) {
    .hero__copy { width: 48%; }
    .hero h1 { font-size: var(--home-hero-heading-tablet); }
  }
</style>
