---
import type { CollectionEntry } from 'astro:content';
import copy from '../data/copy.json';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { author, city, text, sample } = Astro.props.review.data;
---

<figure class="review-card" data-review>
  {sample && <p class="review-card__label">{copy.home.reviews.sampleLabel}</p>}
  <blockquote class="review-card__quote">
    <p>{text}</p>
  </blockquote>
  <figcaption class="review-card__source">
    <span class="review-card__author">{author}</span>
    <span class="review-card__city">{city}</span>
  </figcaption>
</figure>

<style>
  .review-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: start;
    gap: var(--space-md);
    height: 100%;
    margin: 0;
    padding-block-start: var(--space-md);
    border-block-start: var(--line-strong) solid var(--color-ink);
  }

  .review-card__label {
    padding: var(--space-2xs) var(--space-sm);
    border-radius: var(--radius-tile);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    line-height: var(--leading-tight);
  }

  .review-card__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    line-height: var(--leading-lead);
  }

  .review-card__source {
    display: grid;
    font-size: var(--text-sm);
  }

  .review-card__author {
    font-weight: var(--weight-strong);
  }

  .review-card__city {
    color: var(--color-muted);
  }
</style>
