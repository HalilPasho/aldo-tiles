---
import type { CollectionEntry } from 'astro:content';
import copy from '../data/copy.json';
interface Props { review: CollectionEntry<'reviews'>; }
const { author, city, text, sample } = Astro.props.review.data;
---
<figure class="review-card" data-review>
  <blockquote class="review-card__quote"><span class="review-card__mark" aria-hidden="true">&ldquo;</span><p>{text}</p></blockquote>
  <figcaption class="review-card__source">
    {sample && <span class="review-card__stars" aria-hidden="true">{Array.from({length: 5}, () => <svg viewBox="0 0 24 24"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9-6.2-3.3-6.2 3.3 1.2-6.9-5-4.9 6.9-1Z" /></svg>)}</span>}
    {sample && <span class="review-card__label">{copy.home.reviews.sampleLabel}</span>}
    <span class="review-card__identity"><span class="review-card__author">{author}</span><span class="review-card__city">{city}</span></span>
  </figcaption>
</figure>
<style>
  .review-card { display: flex; flex-direction: column; align-items: stretch; gap: var(--space-sm); height: 100%; margin: 0; padding: var(--trust-card-padding); border: var(--line-thin) solid var(--color-line); border-radius: var(--trust-card-radius); background: var(--color-surface-raised); box-shadow: var(--shadow-trust-card); }
  .review-card__label { align-self: start; padding: var(--space-2xs) var(--space-sm); border-radius: var(--radius-field); background: var(--color-accent); color: var(--color-on-accent); font-size: var(--trust-meta-size); font-weight: var(--weight-strong); line-height: var(--leading-tight); }
  .review-card__quote { position: relative; flex: 1; margin: 0; padding-inline-start: var(--trust-quote-inset); font-family: var(--font-body); font-size: var(--trust-copy-size); font-weight: var(--weight-body); font-style: italic; line-height: var(--leading-lead); }
  .review-card__mark { position: absolute; inset-block-start: calc(var(--space-sm) * -1); inset-inline-start: 0; color: var(--color-accent); font-family: var(--font-reference-display); font-size: var(--trust-quote-mark-size); font-style: normal; line-height: 1; }
  .review-card__source { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-xs); padding-block-start: var(--space-sm); margin-inline-start: var(--trust-quote-inset); border-block-start: var(--line-thin) solid var(--color-line); font-size: var(--trust-meta-size); }
  .review-card__stars { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: var(--space-2xs); color: var(--color-accent); }
  .review-card__stars svg { width: var(--trust-star-size); height: var(--trust-star-size); fill: currentColor; }
  .review-card__identity { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-sm); }
  .review-card__author { font-weight: var(--weight-strong); }
  .review-card__city { color: var(--color-muted); }
</style>
