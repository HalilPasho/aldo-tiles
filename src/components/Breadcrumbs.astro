---
import copy from '../data/copy.json';

interface Props {
  items: { name: string; path: string }[];
  showHomeIcon?: boolean;
}

const { items, showHomeIcon = false } = Astro.props;
---

<nav class="breadcrumbs" aria-label={copy.site.breadcrumbLabel}>
  <ol class="breadcrumbs__list">
    {
      items.map(({ name, path }, index) => (
        <li class="breadcrumbs__item">
          {index === items.length - 1 ? (
            <span class="breadcrumbs__current" aria-current="page">
              {name}
            </span>
          ) : (
            <a class="breadcrumbs__link" href={path}>
              {showHomeIcon && index === 0 && <svg class="breadcrumbs__home-icon" viewBox="0 0 48 48" aria-hidden="true"><path d="m4 23 20-18 20 18M10 20v23h10V31h8v12h10V20M33 12V6h7v12" /></svg>}{name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs__home-icon { width: var(--icon-size); height: var(--icon-size); margin-inline-end: var(--space-xs); fill: none; stroke: var(--color-accent-text); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: '';
    width: var(--line-thin);
    height: var(--breadcrumb-divider-height);
    margin-inline: var(--space-sm);
    background: var(--color-line);
    rotate: var(--rake);
  }

  .breadcrumbs__link {
    display: flex;
    align-items: center;
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    color: var(--color-ink);
  }

  .breadcrumbs__current {
    color: var(--color-muted);
  }
</style>
