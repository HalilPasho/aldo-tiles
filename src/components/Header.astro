---
import business from '../data/business.json';
import copy from '../data/copy.json';
import CallLink from './CallLink.astro';
import Logo from './Logo.astro';

const { nav, homeLinkLabel } = copy.site;
const here = Astro.url.pathname;

function currentState(path: string) {
  if (here === path) return 'page';
  return here.startsWith(path) ? 'true' : undefined;
}
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="site-header__logo" href="/" aria-label={`${business.name} ${homeLinkLabel}`}>
      <Logo />
    </a>

    <nav class="nav-full" aria-label={nav.label}>
      <ul class="nav-full__list">
        {
          nav.services.map(({ label, path }) => (
            <li>
              <a class="nav-full__link" href={path} aria-current={currentState(path)}>
                {label}
              </a>
            </li>
          ))
        }
        <li class="nav-full__divider" aria-hidden="true"></li>
        {
          nav.pages.map(({ label, path }) => (
            <li>
              <a class="nav-full__link" href={path} aria-current={currentState(path)}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__call site-header__call--full">
      <CallLink variant="button" />
    </div>
    <div class="site-header__call site-header__call--compact">
      <CallLink />
    </div>

    <details class="nav-menu">
      <summary class="nav-menu__toggle">
        <span class="nav-menu__glyph" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="nav-menu__word--closed">{nav.menuLabel}</span>
        <span class="nav-menu__word--open">{nav.closeLabel}</span>
      </summary>
      <nav class="nav-menu__panel" aria-label={nav.label}>
        <ul class="nav-menu__services">
          {
            nav.services.map(({ label, path }) => (
              <li>
                <a class="nav-menu__tile" href={path} aria-current={currentState(path)}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="nav-menu__pages">
          {
            nav.pages.map(({ label, path }) => (
              <li>
                <a class="nav-menu__link" href={path} aria-current={currentState(path)}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: var(--layer-header);
    container: site-header / inline-size;
    border-block-end: var(--line-thin) solid var(--color-line);
    background: var(--color-surface-raised);
  }

  .site-header__row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-xs);
    min-height: var(--header-height);
  }

  .site-header__logo {
    display: block;
    flex: none;
    width: var(--logo-width-header);
    margin-inline-end: auto;
  }

  .nav-full,
  .site-header__call--full {
    display: none;
  }

  @media (max-width: 389.98px) {
    .site-header__logo {
      width: var(--logo-width-small);
    }

    .nav-menu__toggle > span:not(.nav-menu__glyph) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .nav-menu__toggle {
      justify-content: center;
    }
  }

  @media (max-width: 339.98px) {
    .site-header__call--compact :global(.call-icon) {
      display: none;
    }
  }

  .nav-menu {
    margin-inline-start: auto;
  }

  /* Measured in rem, so this follows the browser's text size as well as the screen: large text puts the phone number on its own row. */
  @container site-header (max-width: 19.9rem) {
    .site-header__row {
      padding-block: var(--space-xs);
    }

    .site-header__call--compact {
      order: 1;
      flex-basis: 100%;
    }
  }

  /* From 390px up the Menu button shows its word and the logo is full size, so the row runs out of room sooner. */
  @media (min-width: 390px) {
    @container site-header (max-width: 24rem) {
      .site-header__row {
        padding-block: var(--space-xs);
      }

      .site-header__call--compact {
        order: 1;
        flex-basis: 100%;
      }
    }
  }

  .nav-menu__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: var(--tap-target);
    min-height: var(--tap-target);
    padding-inline: var(--space-xs);
    border: var(--line-thin) solid var(--color-line);
    border-radius: var(--radius-tile);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .nav-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .nav-menu__glyph {
    display: grid;
    grid-template-columns: repeat(2, var(--menu-glyph-tile));
    gap: var(--menu-glyph-gap);
    transition: rotate var(--duration-quick) var(--ease-out);
  }

  .nav-menu__glyph i {
    height: var(--menu-glyph-tile);
    background: var(--color-ink);
  }

  .nav-menu__glyph i:first-child {
    background: var(--color-accent);
  }

  .nav-menu__word--open,
  .nav-menu[open] .nav-menu__word--closed {
    display: none;
  }

  .nav-menu[open] .nav-menu__word--open {
    display: inline;
  }

  .nav-menu[open] .nav-menu__glyph {
    rotate: 45deg;
  }

  .nav-menu__panel {
    position: absolute;
    inset-block-start: 100%;
    inset-inline: 0;
    display: grid;
    gap: var(--space-sm);
    padding: var(--grout) var(--gutter) var(--space-md);
    border-block-end: var(--line-thin) solid var(--color-line);
    background: var(--color-surface-raised);
    animation: panel-in var(--duration-quick) var(--ease-out);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      translate: 0 calc(var(--grout) * -1);
    }
  }

  .nav-menu__services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--menu-tile-min-width)), 1fr));
    gap: var(--grout);
  }

  .nav-menu__tile {
    display: flex;
    align-items: flex-end;
    height: 100%;
    min-height: var(--menu-tile-min-height);
    padding: var(--space-sm);
    border-radius: var(--radius-tile);
    background: var(--color-ink);
    color: var(--color-on-ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .nav-menu__tile:hover {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .nav-menu__tile[aria-current] {
    box-shadow: inset 0 calc(var(--grout) * -1) 0 var(--color-accent);
  }

  .nav-menu__tile:focus-visible {
    outline-offset: var(--line-thin);
  }

  @media (max-width: 379.98px) {
    .nav-menu__tile {
      font-size: var(--text-base);
    }
  }

  @media (min-width: 760px) {
    .nav-menu__services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .nav-menu__link {
    display: flex;
    align-items: center;
    min-height: var(--button-height);
    border-block-end: var(--line-thin) solid var(--color-line);
    font-weight: var(--weight-strong);
    text-decoration: none;
  }

  .nav-menu__pages li:last-child .nav-menu__link {
    border-block-end: 0;
  }

  .nav-menu__link[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: var(--line-strong);
  }

  /* 1240px at normal text. Measured in rem, so at large text a desktop keeps the Menu button, not a sticky header that fills the screen. */
  @container page (min-width: 77.5rem) {
    .site-header {
      position: sticky;
      inset-block-start: 0;
    }

    .site-header__row {
      gap: var(--space-lg);
      min-height: var(--header-sticky-height);
    }

    .site-header__logo {
      width: var(--logo-width-header-wide);
      margin-inline-end: 0;
    }

    .nav-full {
      display: block;
      margin-inline: auto;
    }

    .site-header__call--full {
      display: block;
    }

    .site-header__call--compact,
    .nav-menu {
      display: none;
    }

    .nav-full__list {
      display: flex;
      align-items: center;
      gap: var(--space-lg);
    }

    .nav-full__divider {
      width: var(--line-thin);
      height: var(--nav-divider-height);
      background: var(--color-line);
    }

    .nav-full__link {
      display: flex;
      align-items: center;
      min-height: var(--tap-target);
      border-block: var(--line-strong) solid transparent;
      white-space: nowrap;
      text-decoration: none;
      transition: border-color var(--duration-quick) var(--ease-out);
    }

    .nav-full__link:hover,
    .nav-full__link[aria-current] {
      border-block-end-color: var(--color-accent);
    }
  }
</style>
