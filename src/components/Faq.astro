---
interface Props {
  heading: string;
  items: { q: string; a: string }[];
}

const { heading, items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="text-row">
      <h2>{heading}</h2>
      <div class="text-row__body faq">
        {items.map(({ q, a }) => (
          <div class="faq__item">
            <h3 class="faq__question">{q}</h3>
            <p class="faq__answer">{a}</p>
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq {
    gap: var(--space-lg);
  }

  .faq__item {
    display: grid;
    gap: var(--space-xs);
  }

  .faq__item + .faq__item {
    padding-block-start: var(--space-lg);
    border-block-start: var(--line-thin) solid var(--color-line);
  }

  .faq__question {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .faq__answer {
    color: var(--color-muted);
  }
</style>
