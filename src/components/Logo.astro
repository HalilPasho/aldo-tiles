---
import { getImage } from 'astro:assets';
import logo from '../assets/em-tile-complete.png';
import darkLogo from '../assets/em-tile-on-dark.png';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const selectedLogo = tone === 'dark' ? darkLogo : logo;
const artwork = await getImage({ src: selectedLogo, width: 900, format: 'webp', quality: 90 });
---

<span class:list={['logo', `logo--${tone}`]}>
  <!-- Frame only the excess blank canvas; keep generous space around the complete mark and its shadow. -->
  <svg viewBox="40 240 1480 580" width="1480" height="580" aria-hidden="true" focusable="false">
    <image href={artwork.src} width={selectedLogo.width} height={selectedLogo.height} />
  </svg>
</span>

<style>
  .logo {
    display: block;
    width: 100%;
  }

  .logo svg {
    width: 100%;
    height: auto;
  }

  .logo--dark {
    background: transparent;
  }

</style>
