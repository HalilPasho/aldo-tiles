---
import type { ImageMetadata } from 'astro';
import business from '../../data/business.json';
import { canonicalUrl, robotsContent, serializeJsonLd } from '../../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object[];
  noindex?: boolean;
  ogImage?: ImageMetadata;
}

const { title, description, path, schema = [], noindex = false, ogImage } = Astro.props;

const siteUrl = business.siteUrl.value;
const canonical = canonicalUrl(siteUrl, path);
const ogImageUrl = ogImage && new URL(ogImage.src, siteUrl).href;
---

<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robotsContent(business.launchReady, noindex)} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
{schema.map((entry) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(entry)} />)}
